{
  "models_to_benchmark": [
    {
      "name": "Claude 4.5 Sonnet",
      "provider": "claude",
      "config": {
        "model": "claude-sonnet-4-5-20250929",
        "api_key": "${ANTHROPIC_API_KEY}"
      }
    },
    {
      "name": "Llama 3.1 70B (VLLM)",
      "provider": "vllm",
      "config": {
        "model_path": "meta-llama/Llama-3.1-70B-Instruct",
        "tensor_parallel_size": 1,
        "gpu_memory_utilization": 0.9
      }
    },
    {
      "name": "Llama 3.3 70B (VLLM)",
      "provider": "vllm",
      "config": {
        "model_path": "meta-llama/Llama-3.3-70B-Instruct",
        "tensor_parallel_size": 1,
        "gpu_memory_utilization": 0.9
      }
    },
    {
      "name": "Qwen 2.5 72B (VLLM)",
      "provider": "vllm",
      "config": {
        "model_path": "Qwen/Qwen2.5-72B-Instruct",
        "tensor_parallel_size": 1,
        "gpu_memory_utilization": 0.9
      }
    },
    {
      "name": "Mixtral 8x22B (VLLM)",
      "provider": "vllm",
      "config": {
        "model_path": "mistralai/Mixtral-8x22B-Instruct-v0.1",
        "tensor_parallel_size": 2,
        "gpu_memory_utilization": 0.9
      }
    },
    {
      "name": "Llama 3.1 8B (Transformers - CPU fallback)",
      "provider": "transformers",
      "config": {
        "model_path": "meta-llama/Llama-3.1-8B-Instruct",
        "device": "cuda",
        "load_in_8bit": true
      }
    }
  ],
  "evaluation_settings": {
    "fields_to_evaluate": [
      "tissue",
      "cell_type",
      "cell_line",
      "treatment",
      "strain",
      "age",
      "sex"
    ],
    "temperature": 0.0,
    "max_tokens": 1000
  }
}
